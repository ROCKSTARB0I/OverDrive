// OVERDRIVE.exe resources: icon, Windows manifest, version info
#include <windows.h>
1 ICON "icon.ico"
1 RT_MANIFEST "overdrive.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ruff Dogs Studios"
      VALUE "FileDescription", "OVERDRIVE"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "OVERDRIVE"
      VALUE "LegalCopyright", "(c) 2026 Ruff Dogs Studios"
      VALUE "OriginalFilename", "OVERDRIVE.exe"
      VALUE "ProductName", "OVERDRIVE"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
